{
  "id": "samsungce.deviceGuard",
  "version": 1,
  "status": "proposed",
  "name": "Device Guard",
  "ephemeral": false,
  "attributes": {
    "workingMinutes": {
      "schema": {
        "type": "object",
        "properties": { "value": { "type": "integer", "minimum": 0 } },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "lockStatus": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": ["normal", "notification", "locked", "grace", "unknown"]
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "enrollmentStatus": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": ["enrolled", "unenrolled", "notFound", "unknown"]
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "nextDueDate": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(?:[1-9]\\d{3}-?(?:(?:0[1-9]|1[0-2])-?(?:0[1-9]|1\\d|2[0-8])|(?:0[13-9]|1[0-2])-?(?:29|30)|(?:0[13578]|1[02])-?31)|(?:[1-9]\\d(?:0[48]|[2468][048]|[13579][26])|(?:[2468][048]|[13579][26])00)-?02-?29)T(?:[01]\\d|2[0-3]):?[0-5]\\d:?[0-5]\\d(?:\\.\\d{3})?(?:Z|[+-][01]\\d(?::?[0-5]\\d)?)|$"
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "deviceState": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": ["activated", "deactivated", "unknown"]
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "message": {
      "schema": {
        "type": "object",
        "properties": { "value": { "type": "string" } },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "paymentInfo": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "amount": { "type": "number" },
              "currency": {
                "type": "string",
                "pattern": "^(Unknown|[A-Z]{3})$"
              },
              "totalEmiPaid": { "type": "integer" },
              "totalEmi": { "type": "integer" },
              "paymentPlan": { "type": "string" }
            }
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    }
  },
  "commands": {
    "refresh": { "name": "refresh", "arguments": [], "sensitive": false }
  }
}
