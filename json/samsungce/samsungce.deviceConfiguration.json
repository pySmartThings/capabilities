{
  "id": "samsungce.deviceConfiguration",
  "version": 1,
  "status": "proposed",
  "name": "Device Configuration",
  "ephemeral": false,
  "attributes": {
    "regionCode": {
      "schema": {
        "type": "object",
        "properties": { "value": { "type": "string", "pattern": "^\\d{10}$" } },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setRegionCode",
      "enumCommands": []
    },
    "temperatureUnit": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "enum": ["F", "C"], "default": "C" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setTemperatureUnit",
      "enumCommands": []
    },
    "supportedTemperatureUnits": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": { "type": "string", "enum": ["F", "C"], "default": "C" }
          }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "countryCode": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setCountryCode",
      "enumCommands": []
    }
  },
  "commands": {
    "setCountryCode": {
      "name": "setCountryCode",
      "arguments": [
        {
          "name": "countryCode",
          "optional": false,
          "schema": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      ],
      "sensitive": false
    },
    "setDateTime": {
      "name": "setDateTime",
      "arguments": [
        {
          "name": "dateTime",
          "optional": false,
          "schema": {
            "type": "string",
            "pattern": "^(?:[1-9]\\d{3}-?(?:(?:0[1-9]|1[0-2])-?(?:0[1-9]|1\\d|2[0-8])|(?:0[13-9]|1[0-2])-?(?:29|30)|(?:0[13578]|1[02])-?31)|(?:[1-9]\\d(?:0[48]|[2468][048]|[13579][26])|(?:[2468][048]|[13579][26])00)-?02-?29)T(?:[01]\\d|2[0-3]):?[0-5]\\d:?[0-5]\\d(?:\\.\\d{3})?(?:Z|[+-][01]\\d(?::?[0-5]\\d)?)$"
          }
        }
      ],
      "sensitive": false
    },
    "setTemperatureUnit": {
      "name": "setTemperatureUnit",
      "arguments": [
        {
          "name": "temperatureUnit",
          "optional": false,
          "schema": { "type": "string", "enum": ["F", "C"], "default": "C" }
        }
      ],
      "sensitive": false
    },
    "setRegionCode": {
      "name": "setRegionCode",
      "arguments": [
        {
          "name": "regionCode",
          "optional": false,
          "schema": { "type": "string", "pattern": "^\\d{10}$" }
        }
      ],
      "sensitive": false
    }
  }
}
